# Copy to .env. Never put service-role or AI keys in VITE_ variables.
# Without credentials the app is explicitly in local demo mode.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
SUPABASE_URL=
SUPABASE_ANON_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Set the real public URL before deployment (no trailing slash).
SITE_URL=https://your-domain.com
VITE_SITE_URL=https://your-domain.com
PORT=3000
# Optional: YouTube may block datacenter IPs. Configure a compliant proxy if needed.
# YOUTUBE_PROXY_URL=http://user:password@your-proxy:port
